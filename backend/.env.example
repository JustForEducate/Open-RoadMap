PORT=3001
HOST=0.0.0.0
# Generate a unique password/hash using npm run admin:setup (repository root).
# ADMIN_PASSWORD_HASH=scrypt:...
# Unset DATABASE_URL uses SQLite. Changing engines does not migrate data.
# DATABASE_URL=postgresql://user:password@host:5432/openroadmap
SQLITE_PATH=../database.sqlite
UPLOADS_DIR=uploads
# Comma-separated exact browser origins; no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production requires HTTPS; enables Secure session cookies.
# NODE_ENV=production
COOKIE_SAME_SITE=lax
# Number of trusted reverse-proxy hops; never enable blindly.
TRUST_PROXY=0
